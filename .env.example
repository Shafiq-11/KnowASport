# KNOWASPORT — ENVIRONMENT VARIABLES CONFIGURATION EXAMPLE
# Copy this file to .env and populate with your credentials

# ── SUPABASE CONFIGURATION ────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── RAZORPAY PAYMENT CONFIGURATION (FRONTEND) ─────────────
# Exposed to client for Razorpay Standard Checkout modal init
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# ── RAZORPAY BACKEND SECRETS (SERVER-SIDE / SUPABASE EDGE) ──
# NEVER expose key secret or webhook secret to client code!
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
